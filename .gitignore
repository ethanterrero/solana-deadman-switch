# Anchor / Rust
# Ignore entries under target/ (not target/ itself) so the IDL + types can be
# re-included below — git can't un-ignore a path whose parent dir is excluded.
target/*
!target/idl/
!target/types/
.anchor/
test-ledger/
.surfpool/
**/*.rs.bk
Cargo.lock

# Node / frontend
node_modules/
dist/
build/
.next/
.turbo/
.vite/
.yarn/
*.tsbuildinfo

# Env / secrets
.env
.env.local
.env.*.local
*.pem
# Keep wallet keypairs OUT of the repo (the program keypair under target/deploy IS gitignored via target/)
*-keypair.json
keypairs/

# OS / editor
.DS_Store
.vscode/
.idea/
*.swp
