# Copy to .env.local and fill in. .env.local is gitignored.

# Devnet RPC endpoint. Leave unset to use public api.devnet.solana.com
# (rate-limited — fine for dev, risky for a live demo).
# For the demo, use a dedicated endpoint, e.g. Helius:
#   VITE_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY
VITE_RPC_URL=

# Set to 1 to force the ARM wizard into fast (seconds) interval mode for the
# live demo, so you don't depend on the ?fast=1 URL flag (which /identify drops).
# Leave unset/empty for normal day-based production behavior.
VITE_FAST=
